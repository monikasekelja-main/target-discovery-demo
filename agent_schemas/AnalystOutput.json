{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "support",
            "challenge",
            "limitation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "statement",
        "citations"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "UNTESTED",
            "SUPPORTED_IN_THIS_EXPERIMENT",
            "USEFUL_EFFECT_EXCLUDED",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "summary",
        "citations"
      ],
      "title": "EvidenceAssessment",
      "type": "object"
    },
    "Retrieval": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "evidence_ids",
        "question"
      ],
      "title": "Retrieval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hypothesis_under_test": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Hypothesis Under Test",
      "type": "string"
    },
    "current_evidence": {
      "$ref": "#/$defs/EvidenceAssessment"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "proposed_action": {
      "enum": [
        "EXPERIMENT_TO_RESOLVE_UNCERTAINTY",
        "ADVANCE_TO_REPLICATION",
        "DEPRIORITIZE_TESTED_HYPOTHESIS",
        "INCONCLUSIVE"
      ],
      "title": "Proposed Action",
      "type": "string"
    },
    "experiment_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Experiment Option Id"
    },
    "next_step": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Next Step",
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Uncertainties",
      "type": "array"
    },
    "retrieval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Retrieval"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "hypothesis_under_test",
    "current_evidence",
    "claims",
    "proposed_action",
    "experiment_option_id",
    "next_step",
    "uncertainties",
    "retrieval"
  ],
  "title": "AnalystOutput",
  "type": "object"
}
